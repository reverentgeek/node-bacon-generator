{
	"name": "node-bacon-generator",
	"version": "0.2.7",
	"description": "",
	"main": "src/index.js",
	"type": "module",
	"engines": {
		"node": ">=20.13.0"
	},
	"scripts": {
		"build": "tailwindcss -i ./src/client/site.css -o ./public/assets/site.css",
		"dev": "nodemon --watch src --watch public -e js,html,css --exec \"npm run build && npm run start\"",
		"lint": "eslint --fix ./",
		"start": "node src/index.js",
		"test": "node --test"
	},
	"keywords": [
		"fastify",
		"bacon",
		"ipsum",
		"generator"
	],
	"author": "David Neal <david@reverentgeek.com> (https://reverentgeek.com/)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/reverentgeek/node-bacon-generator.git"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"eslint": "^10.8.1",
		"eslint-config-reverentgeek": "^7.1.18",
		"nodemon": "^3.1.14",
		"tailwindcss": "^4.3.3"
	},
	"dependencies": {
		"@fastify/static": "^10.1.3",
		"@fontsource/montserrat": "^5.3.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.12.1",
		"fs-extra": "^11.4.0",
		"vue": "^3.5.41",
		"vue3-clipboard": "^1.0.0"
	},
	"packageManager": "pnpm@11.22.0",
	"allowScripts": {
		"@parcel/watcher@2.5.1": true,
		"fsevents@2.3.3": true
	}
}
